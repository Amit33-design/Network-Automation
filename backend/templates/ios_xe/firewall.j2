! ═══════════════════════════════════════════════════════════════════
! NetDesign AI — Cisco IOS-XE  PERIMETER FIREWALL (ZBF)
! Device   : {{ hostname }}
! Role     : Perimeter firewall — zone-based inspection, NAT, OOB mgmt
! Use-case : {{ use_case | upper }}
! Note     : Zones, zone-pairs, inspect policies and NAT are appended by
!            the firewall policy generator (include_firewall_policy).
! ═══════════════════════════════════════════════════════════════════

hostname {{ hostname }}

! ── Domain / AAA / SSH ───────────────────────────────────────────────────────
ip domain-name {{ org | lower | replace(' ', '.') }}.local
crypto key generate rsa modulus 2048

ip ssh version 2
ip ssh time-out 60
ip ssh authentication-retries 3

aaa new-model
aaa authentication login default local
aaa authorization exec default local if-authenticated
aaa accounting exec default start-stop local

username admin privilege 15 algorithm-type sha256 secret <CHANGE-ME-admin-password>
service password-encryption
no service tcp-small-servers
no service udp-small-servers
no ip http server
no ip http secure-server

! ── Management interface (OOB) ───────────────────────────────────────────────
ip vrf MGMT
 description Out-of-band management plane

interface GigabitEthernet0
 description OOB-MANAGEMENT
 vrf forwarding MGMT
 ip address {{ mgmt_ip }} {{ mgmt_mask }}
 no shutdown

ip route vrf MGMT 0.0.0.0 0.0.0.0 {{ mgmt_ip.rsplit('.', 1)[0] }}.1

! ── Loopback ─────────────────────────────────────────────────────────────────
interface Loopback0
 description Firewall-ID
 ip address {{ loopback_ip }} 255.255.255.255
 no shutdown

! ── Data-plane interfaces (zone membership appended by policy generator) ─────
interface GigabitEthernet0/0/0
 description OUTSIDE-UNTRUSTED-WAN
 ip address <CHANGE-ME-outside-ip> <CHANGE-ME-outside-mask>
 no shutdown

interface GigabitEthernet0/0/1
 description INSIDE-TRUSTED-LAN
 ip address <CHANGE-ME-inside-ip> <CHANGE-ME-inside-mask>
 no shutdown

interface GigabitEthernet0/0/2
 description DMZ-PUBLIC-SERVERS
 ip address <CHANGE-ME-dmz-ip> <CHANGE-ME-dmz-mask>
 no shutdown

! ── Default route toward upstream ────────────────────────────────────────────
ip route 0.0.0.0 0.0.0.0 <CHANGE-ME-upstream-gateway>

! ── Logging / time ───────────────────────────────────────────────────────────
logging buffered 64000 informational
logging host <CHANGE-ME-syslog-server> vrf MGMT
ntp server <CHANGE-ME-ntp-server>
service timestamps log datetime msec localtime show-timezone

! ── Console / VTY hardening ──────────────────────────────────────────────────
line console 0
 exec-timeout 10 0
 logging synchronous
line vty 0 4
 exec-timeout 10 0
 transport input ssh
 access-class 10 in

access-list 10 remark MGMT-ACCESS
access-list 10 permit {{ mgmt_ip.rsplit('.', 1)[0] }}.0 0.0.0.255
access-list 10 deny   any log
