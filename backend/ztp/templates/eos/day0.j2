! ============================================================
! NetDesign AI — Arista EOS DAY 0 ZTP BOOTSTRAP CONFIG
! Device  : {{ hostname }}
! Serial  : {{ serial }}
! Role    : {{ role }}
! Generated by NetDesign AI ZTP Server
! ============================================================

hostname {{ hostname }}

!-- Local users
username admin privilege 15 role network-admin secret {{ admin_password }}
username netdesign privilege 15 role network-admin secret {{ netdesign_password }}

!-- Management in vrf MGMT from the first boot: the VRF the Day-N config
!-- uses. EOS clears an interface's address when its VRF changes, so booting
!-- in the default VRF meant the Day-N push cut its own session.
vrf instance MGMT
interface Management1
   description MGMT-ZTP
   vrf MGMT
   ip address {{ mgmt_ip }}/24
   no shutdown
{% if mgmt_gw %}

!-- Default route for management
ip route vrf MGMT 0.0.0.0/0 {{ mgmt_gw }}
{% endif %}

!-- Loopback
interface Loopback0
   description ROUTER-ID
   ip address {{ loopback_ip }}/32
   no shutdown

!-- SSH
management ssh
   idle-timeout 10
   authentication mode password
   vrf MGMT
      no shutdown

!-- NTP
ntp server vrf MGMT {{ ntp_server }} prefer

!-- Syslog
logging vrf MGMT host {{ syslog_server }} 514

!-- LLDP
lldp run

!-- Disable ZTP after first boot
event-handler DISABLE-ZTP
   trigger on-boot
   action bash touch /mnt/flash/zerotouch-config
   delay 2

!-- Banner
banner login
*** NetDesign AI EOS — ZTP Bootstrap Complete ***
*** {{ hostname }} | {{ role }} ***
EOF

end
